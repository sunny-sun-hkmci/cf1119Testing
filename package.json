{
  "name": "harbourlights-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Fictional Harbour Lights Festival 2027 microsite: demo of a governed AI-assisted web workflow.",
  "type": "module",
  "scripts": {
    "build": "node scripts/check-site.mjs",
    "lint:html": "html-validate \"public/**/*.html\"",
    "check": "npm run build && npm run lint:html",
    "check:headers": "node scripts/check-headers.mjs",
    "dev": "wrangler dev",
    "dryrun": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "html-validate": "^9.0.0",
    "wrangler": "^4.0.0"
  },
  "engines": { "node": ">=20" }
}
