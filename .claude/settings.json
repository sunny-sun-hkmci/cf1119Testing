{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(wrangler deploy*)",
      "Bash(npx wrangler deploy*)",
      "Bash(npx wrangler@* deploy*)",
      "Bash(pnpm dlx wrangler deploy*)",
      "Bash(bunx wrangler deploy*)",
      "Bash(wrangler versions deploy*)",
      "Bash(npx wrangler versions deploy*)",
      "Bash(wrangler rollback*)",
      "Bash(npx wrangler rollback*)",
      "Bash(cf deploy*)",
      "Bash(npm run deploy*)",
      "Bash(pnpm deploy*)",
      "Bash(yarn deploy*)",
      "Bash(git push*main*)",
      "Bash(git push*master*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(gh pr merge*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.dev.vars*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(./.env*)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-deploy.mjs\""
          }
        ]
      }
    ]
  }
}
